# Database (Prisma)
# Local (non-docker):
DATABASE_URL="postgresql://postgres:rakibhasan@localhost:5432/planora?schema=public"
# Docker compose:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/planora?schema=public"

# Server
PORT=5000
NODE_ENV=development
# Set SEED_ALLOW_RESET=true to allow prisma db seed when NODE_ENV=production
SEED_ALLOW_RESET=
FRONTEND_URL="http://localhost:3000"

# JWT — access vs refresh must use different secrets
JWT_ACCESS_SECRET="change-me-access-secret-long-random"
JWT_REFRESH_SECRET="change-me-refresh-secret-different-from-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP (e.g. Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Planora <noreply@yourdomain.com>"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (optional — leave REDIS_HOST empty to disable HTTP response caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Docker compose:
# REDIS_HOST=redis

# Rate limiting — optional bypass for integration tests (never set in production)
RATE_LIMIT_BYPASS_TOKEN=

# Payments — mock | sslcommerz | shurjopay (default: mock)
PAYMENT_PROVIDER=mock
# Public API base used for SSLCommerz `ipn_url` (defaults to BETTER_AUTH_URL). Must be reachable from the internet in production.
# PUBLIC_API_URL=https://api.yourdomain.com
# SSLCommerz (optional — omit store id/pass to use demo redirect to /payments)
# SSLCOMMERZ_LIVE=false
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWD=
# IPN (server): POST /api/payments/webhooks/sslcommerz — also sent automatically when initiating a session if credentials exist.
# ShurjoPay (optional)
# SHURJOPAY_LIVE=false
# SHURJOPAY_USERNAME=
# SHURJOPAY_PASSWORD=
# SHURJOPAY_PREFIX=PLN
# Async notify (if you configure it in Shurjo dashboard): POST /api/payments/webhooks/shurjopay

# Reviews — hours after event start during which authors may edit/delete (default: 336 ≈ 14 days)
# REVIEW_EDIT_WINDOW_HOURS=336
