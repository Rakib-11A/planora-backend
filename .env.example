# Database (Prisma) — replace user, password, host, db name
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/planora?schema=public"

# Auth — JWT_SECRET must be long and random in production

JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"


# Server — PORT defaults to 5000 in code if unset
PORT=5000
NODE_ENV=development


# CORS — browser origin of your frontend (e.g. Next.js dev server)
FRONTEND_URL="http://localhost:3000"
