# Database (Prisma)
# Local (non-docker):
DATABASE_URL="postgresql://postgres:rakibhasan@localhost:5432/planora?schema=public"
# Docker compose:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/planora?schema=public"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# JWT — access vs refresh must use different secrets
JWT_ACCESS_SECRET="change-me-access-secret-long-random"
JWT_REFRESH_SECRET="change-me-refresh-secret-different-from-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP (e.g. Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Planora <noreply@yourdomain.com>"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (optional — leave REDIS_HOST empty to disable HTTP response caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Docker compose:
# REDIS_HOST=redis

# Rate limiting — optional bypass for integration tests (never set in production)
RATE_LIMIT_BYPASS_TOKEN=
