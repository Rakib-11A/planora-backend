// Shared enums for all domain models

/// Application role: standard attendee vs platform admin.
enum UserRole {
  USER
  ADMIN
}

/// Who can discover / register for the event.
enum EventType {
  PUBLIC
  PRIVATE
}

/// Lifecycle of a user’s registration for an event.
enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  BANNED
}

/// Response to a private-event invite.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Payment lifecycle for registration fees.
enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  PENDING
  COMPLETED
  REFUNDED
}

/// How the user signs in: local email/password vs Google OAuth.
enum AuthProvider {
  EMAIL
  GOOGLE
}

/// Purpose of a one-time code (hashed at rest).
enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
