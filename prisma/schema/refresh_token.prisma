// RefreshToken — long-lived session rows; store only hashed refresh token values.

model RefreshToken {
  id        String   @id @default(cuid())
  /// Hashed refresh token (never store raw tokens).
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Client IP when the token was issued (audit / abuse detection).
  ipAddress String?
  /// Client user-agent when issued.
  userAgent String?

  @@index([userId])
}
