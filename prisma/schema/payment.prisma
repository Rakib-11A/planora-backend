// Payment — registration or other event-related charges.

model Payment {
  id              String        @id @default(cuid())
  userId          String
  eventId         String
  participationId String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(INITIATED)
  provider        String
  transactionId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participation Participation   @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([eventId]) // Used by: event payment lookup and verification checks
  @@index([userId]) // Used by: GET /api/payments/me (base filter)
  @@index([participationId]) // Used by: payment existence checks per participation
  @@index([userId, createdAt]) // Used by: GET /api/payments/me (recent-first listing)
  @@index([eventId, status]) // Used by: admin/monitoring filters by event and payment state
}
