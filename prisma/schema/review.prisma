// Review — one rating + comment per user per event (enforced by @@unique).
// Validate rating 1–5 in application or DB check constraint in migrations.

model Review {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  rating    Int
  comment   String?  @db.Text
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // Used by: prevent duplicate review per user/event
  @@index([eventId]) // Used by: event review summary aggregates
  @@index([eventId, deletedAt]) // Used by: active review filtering on event pages
  @@index([eventId, deletedAt, createdAt]) // Used by: GET /api/events/:eventId/reviews (latest-first)
}
