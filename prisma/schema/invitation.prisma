// Invitation — private events: one row per invitee per event.

model Invitation {
  id        String           @id @default(cuid())
  eventId   String
  inviterId String
  inviteeId String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee User  @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter User  @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviteeId]) // Used by: prevent duplicate invite per event/invitee
  @@index([inviteeId]) // Used by: GET /api/invitations/me (base filter)
  @@index([inviterId]) // Used by: inviter-scoped invitation queries
  @@index([eventId, status, createdAt]) // Used by: GET /api/events/:eventId/invitations?status=
  @@index([inviteeId, createdAt]) // Used by: GET /api/invitations/me (recent-first listing)
}
