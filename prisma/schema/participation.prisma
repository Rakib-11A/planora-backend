// Participation — a user’s membership in an event (registration / attendance).
// Deleting the event removes all participations (cascade).

model Participation {
  id        String              @id @default(cuid())
  userId    String
  eventId   String
  status    ParticipationStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Reserved relation for payment block integration.
  payment Payment?

  @@unique([userId, eventId]) // Used by: join/cancel participation idempotency checks
  @@index([eventId]) // Used by: GET /api/events/:eventId/participants
  @@index([userId]) // Used by: GET /api/me/participations (base filter)
  @@index([eventId, status, createdAt]) // Used by: GET /api/events/:eventId/participants?status=
  @@index([userId, createdAt]) // Used by: GET /api/me/participations (recent-first listing)
  @@index([userId, eventId, status]) // Used by: approved-participation validation before review create
}
