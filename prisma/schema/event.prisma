// Event — scheduled occurrence; owned by one organizer; has joins, invites, etc.

model Event {
  id               String    @id @default(cuid())
  title            String
  description      String    @db.Text
  date             DateTime
  time             String
  venue            String?
  eventLink        String?
  type             EventType
  registrationFee  Decimal   @default(0) @db.Decimal(12, 2)
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  organizerId      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Organizer cannot be deleted while still referenced; reassign or delete events first.
  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)

  participations Participation[]
  invitations    Invitation[]
  reviews        Review[]
  payments       Payment[]
}
