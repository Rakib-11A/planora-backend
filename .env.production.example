# Core server
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
FRONTEND_URL=http://168.144.44.150

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-long-random
JWT_REFRESH_SECRET=change-me-refresh-secret-different-from-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# COOKIE_SAME_SITE=strict

# Required by current env loader
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Planora <noreply@yourdomain.com>
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://168.144.44.150
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Optional infra
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_BYPASS_TOKEN=

# Payments
PAYMENT_PROVIDER=mock
